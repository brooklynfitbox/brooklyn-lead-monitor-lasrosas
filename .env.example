# Copia este archivo a .env y rellena lo marcado como [RELLENAR].
# El script instalar-vps.sh ya hace la copia automáticamente si no existe.
# Nunca subas un .env relleno a git ni lo compartas por chat/email.

# --- Identidad ---------------------------------------------------------------
CENTER_NAME=[RELLENAR - copia el valor exacto de CENTER_NAME desde el repo GitHub de Las Rosas -> Settings -> Variables]

# --- Portal --------------------------------------------------------------
PORTAL_BASE_URL=https://myh4c.brooklynfitzone.com
PORTAL_USERNAME=lasrosas@brooklynfitboxing.com
PORTAL_PASSWORD=[RELLENAR - la contraseña de este login del portal]

LEADS_CLIENT=graphql
LEADS_API_PATH=/fs1

# Opcional: copia el valor exacto desde el repo de GitHub de este centro ->
# Settings -> Secrets and variables -> Actions -> pestaña Variables. Si lo
# dejas en blanco, el cliente usa una consulta de reserva y avisa en el log
# — funciona igual, pero es mejor poner la exacta ya validada.
LEADS_GRAPHQL_QUERY=[RELLENAR - opcional, ver comentario]
LEADS_GRAPHQL_OPERATION=[RELLENAR - opcional, ver comentario]
LEADS_GRAPHQL_VARIABLES={}

LEADS_STATUS_FILTER=pre-order
NOTIFY_RECENT_LEADS_ONLY=true
NOTIFY_TIMEZONE=Europe/Madrid

# --- Notificación ----------------------------------------------------------
NOTIFY_CHANNEL=email

# --- Email -------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=avisosleadsinternos@gmail.com
SMTP_PASSWORD=[RELLENAR - la contraseña de aplicación de Gmail de avisosleadsinternos@gmail.com]
MAIL_FROM=avisosleadsinternos@gmail.com
MAIL_TO=avisosleadsinternos@gmail.com

NOTIFY_INCLUDE_PERSONAL_DATA=false

# --- WhatsApp (solo si activáis NOTIFY_CHANNEL=email,whatsapp) -------------
# Ver PENDIENTE-WHATSAPP.md — nada de esto está configurado todavía.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TO=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=es
WHATSAPP_API_VERSION=v21.0

# --- CallMeBot (solo si activáis NOTIFY_CHANNEL=email,callmebot) -----------
# Alternativa gratuita y rápida de activar al WhatsApp oficial de arriba,
# mientras esa vía está pendiente de Brooklyn Central. Solo se envía a un
# número, el que se dio de alta en callmebot.com (ver documentación del
# proyecto). No lleva datos personales salvo que actives
# NOTIFY_INCLUDE_PERSONAL_DATA.
CALLMEBOT_PHONE=
CALLMEBOT_APIKEY=

# --- Navegador ---------------------------------------------------------------
# Déjalo en blanco en Ubuntu/Debian (usa el Chromium propio de Playwright).
# Ponlo a "chrome" solo en AlmaLinux/Rocky/RHEL, donde se instala Google
# Chrome del sistema en su lugar (ver INSTRUCCIONES-VPS-ALMALINUX.md) — el
# instalador para esa distro ya lo rellena solo.
BROWSER_CHANNEL=

# --- Vigilancia (Healthchecks.io) -------------------------------------------
# Opcional pero recomendado. Crea una cuenta gratis en healthchecks.io, crea
# un "check" para este centro con periodo esperado ~10-15 min, y pega aquí
# la URL de ping que te da (algo como https://hc-ping.com/xxxxxxxx-xxxx-...).
# Si se deja en blanco, el monitor funciona igual, simplemente sin esta
# alarma adicional de "el servidor se cayó / perdió internet".
HEALTHCHECK_URL=

# --- Comportamiento ---------------------------------------------------------
DATABASE_PATH=state/leads.db
STORAGE_STATE_PATH=state/storage_state.json
LOG_LEVEL=INFO
LOG_PLAIN=true
SEED_WITHOUT_NOTIFYING=true
REQUEST_TIMEOUT_SECONDS=30
MAX_ATTEMPTS=4
